{
  "manifest_version": 3,
  "name": "StudyDock - Free Canvas Study Companion",
  "short_name": "StudyDock",
  "description": "Free, local study companion with always-active tabs, Canvas privacy guard, quiz recall, and an on-page toolbar. No account, subscription, or usage limits.",
  "version": "2.0.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StudyDock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/courses/*/quizzes/*/take*"
      ],
      "js": [
        "content/quiz-loader.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
